<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:fitsSystemWindows="true"
    tools:context=".main.view.MainActivity">

    <!-- 상태바 배경색 (엣지 투 엣지 대응, 상태바 높이만큼 MainActivity에서 동적으로 크기 지정) -->
    <View
        android:id="@+id/view_status_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@android:color/white" />

    <!-- 메인 콘텐츠를 담을 프레임 레이아웃 -->
    <FrameLayout
        android:id="@+id/frm_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 하단 네비게이션 바 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:paddingTop="7dp"
        android:paddingBottom="13dp"
        app:itemIconSize="24dp"
        app:itemTextAppearanceActive="@style/B4_RG12"
        app:itemTextAppearanceInactive="@style/B4_RG12"
        app:itemTextColor="@drawable/selector_menu_text_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

    <!-- 스피드 다이얼 배경 딤 -->
    <View
        android:id="@+id/view_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:elevation="10dp"
        android:visibility="gone" />

    <!-- 스피드 다이얼 메뉴 -->
    <LinearLayout
        android:id="@+id/layout_add_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="100dp"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/card_ocr"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_menu_pill"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="22dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_camera"
                app:tint="@color/main_blue_1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="카메라로 촬영"
                android:textColor="#1F2A44"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_manual"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_menu_pill"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="22dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_edit"
                app:tint="@color/main_blue_1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="직접 입력"
                android:textColor="#1F2A44"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 플로팅 액션 버튼 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floating_btn_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:contentDescription="@string/fab_add_medicine"
        android:src="@drawable/ic_plus"
        app:backgroundTint="@color/main_blue_1"
        app:elevation="14dp"
        app:layout_anchor="@id/bottom_nav_main"
        app:layout_anchorGravity="center"
        app:maxImageSize="17dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>